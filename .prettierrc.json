{
	"printWidth": 120,
	"useTabs": true,
	"tabWidth": 4,
	"singleQuote": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-go-template"],
	"overrides": [
		{
			"files": ["layouts/**/*.html"],
			"options": {
				"parser": "go-template"
			}
		}
	]
}
